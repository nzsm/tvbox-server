+    private void lockHighestVideoTrackIfEnabled() {
+        try {
+            if (!Hawk.get(HawkConfig.LOCK_QUALITY, true)) return;
+            MappingTrackSelector.MappedTrackInfo mappedInfo = trackSelector.getCurrentMappedTrackInfo();
+            if (mappedInfo == null) return;
+            for (int rendererIndex = 0; rendererIndex < mappedInfo.getRendererCount(); rendererIndex++) {
+                if (mappedInfo.getRendererType(rendererIndex) != C.TRACK_TYPE_VIDEO) continue;
+                TrackGroupArray groups = mappedInfo.getTrackGroups(rendererIndex);
+                if (groups == null || groups.length == 0) return;
+                int bestGroup = 0, bestTrack = 0;
+                long bestScore = -1;
+                for (int groupIndex = 0; groupIndex < groups.length; groupIndex++) {
+                    TrackGroup group = groups.get(groupIndex);
+                    if (group == null) continue;
+                    for (int trackIndex = 0; trackIndex < group.length; trackIndex++) {
+                        Format fmt = group.getFormat(trackIndex);
+                        if (fmt == null) continue;
+                        long score = (long) (fmt.height > 0 ? fmt.height : 0) * 10000L + (fmt.width > 0 ? fmt.width : 0);
+                        if (fmt.bitrate > 0) score = score * 2 + Math.min(fmt.bitrate / 1024L, 1000000L);
+                        if (score > bestScore) { bestScore = score; bestGroup = groupIndex; bestTrack = trackIndex; }
+                    }
+                }
+                if (bestScore <= 0) return;
+                DefaultTrackSelector.SelectionOverride override = new DefaultTrackSelector.SelectionOverride(bestGroup, bestTrack);
+                DefaultTrackSelector.Parameters.Builder builder = trackSelector.buildUponParameters();
+                builder.setRendererDisabled(rendererIndex, false);
+                builder.clearSelectionOverrides(rendererIndex);
+                builder.setSelectionOverride(rendererIndex, groups, override);
+                trackSelector.setParameters(builder.build());
+                LOG.i("echo-lock-quality: locked highest video track g=" + bestGroup + " t=" + bestTrack);
+                return;
+            }
+        } catch (Exception e) {
+            LOG.i("echo-lock-quality error: " + e.getMessage());
+        }
+    }
